# ==============================================================================
# CampusX Production Environment Configuration Template
# ==============================================================================

# ── Flask Core Configuration ──────────────────────────────────────────────────
FLASK_APP=run.py
# Set FLASK_ENV to "production" in live environments ("development" for local dev)
FLASK_ENV=production
# CRITICAL: Generate a strong 64-char random key for production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# ── JWT Authentication Configuration ─────────────────────────────────────────
# CRITICAL: Generate a dedicated strong key for JWT signing
JWT_SECRET_KEY=change-this-to-a-secure-256-bit-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=1209600

# ── PostgreSQL Database Configuration ────────────────────────────────────────
POSTGRES_USER=campusx
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=campusx
DATABASE_URL=postgresql://campusx:your_secure_postgres_password_here@db:5432/campusx

# Database Connection Pool Options
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ── Redis & Background Task Queue (Celery) ───────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── File & Study Material Storage Backend ─────────────────────────────────────
# "local" for filesystem storage, "s3" for AWS S3 / MinIO
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_CONTENT_LENGTH=104857600

# S3 / MinIO Configuration (Required if STORAGE_BACKEND=s3)
S3_BUCKET=campusx-resources
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Vector Database & AI Configuration ────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=2.0

# LLM Providers (Optional for offline demo, required for live AI responses)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Security, CORS & Logging ──────────────────────────────────────────────────
# Comma-separated allowed frontend origins, or your domain (e.g. https://campusx.edu)
CORS_ORIGINS=https://campusx.edu,http://localhost:5000
LOG_LEVEL=INFO
