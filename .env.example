# CampusX Sprint 4 - Authentication Environment Configuration Template

# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# JWT Authentication Configuration
JWT_SECRET_KEY=change-this-to-a-secure-256-bit-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=900

# PostgreSQL Database Configuration
POSTGRES_USER=campusx
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campusx_dev
DATABASE_URL=postgresql://campusx:your_secure_postgres_password_here@localhost:5432/campusx_dev

# Database Connection Pool Options
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
LOG_LEVEL=INFO
